# AdSenseの識別子は公開情報です。APIトークン等は置かないでください。
# 未取得・空欄では確認用meta / ads.txt / 広告枠を生成しません。
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_LP_SLOT=
# 審査・広告ユニット作成・同意管理設定の完了後にtrueにします。
VITE_ADSENSE_ENABLED=false

# 公開URLを変更するときは両方を異なるHTTPSオリジンにします。
VITE_APP_URL=https://app.nokosu-kakebo.workers.dev/
VITE_SITE_URL=https://www.nokosu-kakebo.workers.dev/
