{
  "name": "nokori-kakeibo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build && vite build --mode app",
    "preview": "vite preview",
    "test": "node --import tsx --test src/*.test.ts",
    "check:dist": "node scripts/check-dist.mjs",
    "check": "npm test && npm run build && npm run check:dist",
    "security:scan": "gitleaks git --redact --no-banner --ignore-gitleaks-allow --config .gitleaks.toml --log-opts=--all .",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "preview:app": "vite preview --mode app --port 4174",
    "dev:app": "vite --mode app --port 5174 --strictPort",
    "dev:site": "vite --port 5173 --strictPort",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5",
    "typescript": "~5.7.2",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.5",
    "@playwright/test": "^1.64.1"
  },
  "engines": {
    "node": "22.x"
  }
}
