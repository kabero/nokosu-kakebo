{
  "name": "nokori-kakeibo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test src/finance.test.ts",
    "check:dist": "node scripts/check-dist.mjs",
    "check": "npm test && npm run build && npm run check:dist",
    "security:scan": "gitleaks git --redact --no-banner --ignore-gitleaks-allow --config .gitleaks.toml --log-opts=--all .",
    "hooks:install": "git config --local core.hooksPath .githooks"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5",
    "typescript": "~5.7.2",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.5"
  },
  "engines": {
    "node": "22.x"
  }
}
